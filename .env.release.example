# Template for the .env that sits next to compose.release.yml on the server:
# copy it with `cp .env.release.example .env` and replace the placeholders.
# Unlike .env.example, which configures local development, this one configures
# a deployed release.

# The published image, and the version of it to run. Pin TASKLY_TAG to a
# released version, such as 1.2.3, so that a restart brings back the same image.
TASKLY_IMAGE=docker.io/your-docker-hub-account/taskly
TASKLY_TAG=latest

# The domain the application is served on.
DOMAIN=taskly.example.com

PROJECT_NAME="Taskly"

# Generate each of these with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Postgres
POSTGRES_PASSWORD=changethis

# Emails. Leave SMTP_USER and SMTP_PASSWORD empty for a server that needs no
# authentication, and leave SMTP_HOST empty to send no email at all.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com

# Error reporting. Leave empty to disable Sentry.
SENTRY_DSN=
