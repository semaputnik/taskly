# Template for the local .env: copy it with `cp .env.example .env` and replace the placeholders.
# CI copies this file verbatim, so it must contain only non-secret placeholder values.

# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Taskly"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Webhooks (and a Paperless address) refuse URLs that resolve to loopback or a
# private range, so a visitor cannot make the server probe its own network.
# Set to true when your bot users run on this machine or your LAN.
# OUTBOUND_ALLOW_PRIVATE_ADDRESSES=false

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
