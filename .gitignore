# Local secrets; .env.example is the tracked template. Anchored so frontend/.env stays tracked.
/.env
.vscode/
node_modules/
backend/app/frontend/
# Default local attachment storage backend (ADR-0002); relative to backend/.
backend/data/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Impeccable skill: only the Claude Code copy is tracked, without its heavy
# generated files (the platform binary, the font index, the bundled browser
# script). The copies for other tools stay local.
/.agents/
/.github/agents/
/.github/hooks/
/.github/skills/
/.claude/skills/impeccable/scripts/bin/
/.claude/skills/impeccable/scripts/data/font-index.json
/.claude/skills/impeccable/scripts/live-browser.js
# Personal Claude Code settings.
/.claude/settings.local.json

# macOS folder metadata.
.DS_Store
# Design references gathered while working: third-party mockups and personal
# screenshots that do not belong in a public history.
/docs/reference/
